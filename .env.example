# Copy to .env (never commit real keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
API_URL=http://127.0.0.1:4010
PORT=4010

# Public URLs used in Slack button links (localhost is fine for recording on this machine)
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:4010

# Real Slack — Bot User OAuth Token (scopes: chat:write, chat:write.public)
SLACK_BOT_TOKEN=
# Channel ID (e.g. C0123456789) — invite the bot to the channel first
SLACK_CHANNEL_ID=

# Optional: Incoming Webhook that posts as username "PagerDuty"
# If unset, the Room bot posts a PagerDuty-styled alert instead
SLACK_PAGERDUTY_WEBHOOK_URL=
